# ACDP Platform Environment Configuration Template

# PostgreSQL (Relational & Gold Layer Data Marts)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=acdp_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DuckDB (Lakehouse & In-process Analytics)
DUCKDB_DATABASE_PATH=./lakehouse/acdp.duckdb

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# LLM Providers (for Schema Parsing & RAG)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Backend FastAPI Service
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Frontend Next.js Service
NEXT_PUBLIC_API_URL=http://localhost:8000
