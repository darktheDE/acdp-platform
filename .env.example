# ACDP Platform Environment Configuration Template

# PostgreSQL 18 (OLTP App DB - SPEC-0004 & SPEC-0006)
POSTGRES_USER=acdp
POSTGRES_PASSWORD=acdp_local_dev_only
POSTGRES_DB=acdp_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DuckDB (Lakehouse Gold Star Schema & In-process Analytics)
DUCKDB_DATABASE_PATH=./data/lakehouse/acdp.duckdb

# Lakehouse Medallion Storage Configuration (SPEC-0001 / TODO-CODE-02)
# Supported Backends: 'local' | 'cloudflare_r2'
BRONZE_STORAGE_BACKEND=local
BRONZE_STORAGE_URI=./data/lakehouse/bronze
SILVER_STORAGE_URI=./data/lakehouse/silver
GOLD_STORAGE_URI=./data/lakehouse/gold
BUCKET_NAME=acdp-lakehouse
USD_TO_VND_RATE=25400

# Optional Object Storage (Cloudflare R2 / AWS S3)
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_ALLOW_HTTP=false
AWS_S3_ALLOW_UNSAFE_RENAME=true

# Vector Database (Qdrant)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# LLM Providers (for Schema Parsing & RAG)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend FastAPI Service & Auth (SPEC-0004)
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=replace_with_32_byte_random_hex_in_production
CORS_ORIGINS=http://localhost:3000

# Frontend Next.js 16 Service (SPEC-0005 / SPEC-0006)
INTERNAL_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
