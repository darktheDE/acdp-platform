# ACDP Platform Environment Configuration Template

# PostgreSQL 18 / Supabase OLTP App DB (ADR-0002, SPEC-0004, TASK-CLD-04)
# POSTGRES_MODE: 'auto' (prioritizes SUPABASE_DATABASE_URL/DATABASE_URL), 'cloud', or 'local'
POSTGRES_MODE=auto
SUPABASE_DATABASE_URL=
SUPABASE_DIRECT_URL=
DATABASE_URL=
POSTGRES_POOL_MODE=auto
POSTGRES_SSL_MODE=auto
POSTGRES_USER=acdp
POSTGRES_PASSWORD=acdp_local_dev_only
POSTGRES_DB=acdp_app
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DuckDB & MotherDuck BI (In-memory Analytics via httpfs over Cloudflare R2 s3://)
DUCKDB_MEMORY_LIMIT=256MB
DUCKDB_THREADS=2
DUCKDB_R2_TABLE_CACHE=true
GOLD_MART_CACHE_ENABLED=true
GOLD_MART_CACHE_TTL_SECONDS=600
GOLD_MART_CACHE_MAX_ENTRIES=256
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=acdp_gold

# Lakehouse Medallion Storage Configuration (Cloudflare R2 Exclusive - DIR-021)
BRONZE_STORAGE_BACKEND=cloudflare_r2
BRONZE_STORAGE_URI=s3://acdp-lakehouse/bronze
SILVER_STORAGE_URI=s3://acdp-lakehouse/silver
GOLD_STORAGE_URI=s3://acdp-lakehouse/gold
BUCKET_NAME=acdp-lakehouse
USD_TO_VND_RATE=25400

# Cloudflare R2 Object Storage Credentials (Required)
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
AWS_ALLOW_HTTP=false
AWS_S3_ALLOW_UNSAFE_RENAME=true

# Vector Database (Qdrant: 'auto'/'cloud' prioritizes Qdrant Cloud; 'local' uses --profile local-backup)
QDRANT_MODE=auto
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=
QDRANT_COLLECTION=acdp_competitions_bge_m3
QDRANT_BGE_COLLECTION=acdp_competitions_bge_m3

# LLM & Embedding Providers (Cloudflare Workers AI + Google AI Studio + Fallback Chain)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-m3
EMBEDDING_MODEL=@cf/baai/bge-m3
CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=
GROQ_API_KEY=
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_CHAT_MODEL=google/gemma-4-31b-it:free
LLM_FALLBACK_ENABLED=true
USE_LITELLM_ROUTER=false
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=128
RAG_MAX_OUTPUT_TOKENS=600
RATE_LIMIT_ENABLED=true

# OLTP Weekly Backup on Cloudflare R2 (TASK-CLD-06)
OLTP_BACKUP_R2_PREFIX=backups/oltp
OLTP_BACKUP_RETENTION_DAYS=30

# Discovery 3-Tier Search APIs (TASK-ING-03 - Free Tier)
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
DISCOVERY_MAX_QUERIES_PER_RUN=12

# Backend FastAPI Service & Auth (SPEC-0004)
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=replace_with_32_byte_random_hex_in_production
ADMIN_EMAILS=
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# Frontend Next.js 16 Service (SPEC-0005 / SPEC-0006 / TASK-CLD-05)
INTERNAL_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_REWRITE_PROXY=false
